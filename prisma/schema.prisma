generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FaceIcon {
  BOY_FACE
  LADY_FACE
  GRANPA_FACE
  WHITE_FACE
  BLACK_FACE
  BROWN_FACE
  BUG_FACE
}

enum GameType {
  STAR_SHIELD
  NULL_HAND
  ERROR_HUNTER
}

enum MatchStatus {
  SETUP
  WAITING
  PLAYING
  FINISHED
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String   @unique
  comment   String?
  faceIcon  FaceIcon @default(BOY_FACE) @map("face_icon")
  createdAt DateTime @default(now()) @map("created_at")

  // リレーション名をキャメルケースに統一
  errorEvents     ErrorEvent[]
  matches         Match[]
  joinedRooms     RoomUser[]
  createdRooms    Room[]           @relation("CreatedRooms")
  userIDPs        UserIDP[]
  guestHands      GuestHand[]
  jankenLogs      JankenLog[]
  matchScores     MatchScore[]
  monthlyRankings           MonthlyRanking[]
  pointLogs                 PointLog[]
  roomDeletedNotifications RoomDeletedNotification[]
  typingShootShooterMatches TypingShootMatch[] @relation("TypingShootShooter")
  typingShootTypistMatches  TypingShootMatch[] @relation("TypingShootTypist")
  starShieldClearAsShooter  StarShieldClearRecord[] @relation("StarShieldClearShooter")
  starShieldClearAsTypist   StarShieldClearRecord[] @relation("StarShieldClearTypist")
  starShieldProgress       StarShieldUserProgress?
  starShieldNormalAttacks  StarShieldUserNormalAttack[]
  starShieldSpecialAttacks StarShieldUserSpecialAttack[]
  starShieldPurchaseHistory StarShieldPurchaseHistory[]

  @@map("users")
}

model RoomDeletedNotification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roomName  String   @map("room_name")
  deletedAt DateTime @default(now()) @map("deleted_at")
  isRead    Boolean  @default(false) @map("is_read")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("room_deleted_notifications")
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

model Room {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  createdBy      String     @map("created_by") @db.Uuid
  currentMatchId String?    @map("current_match_id") @db.Uuid
  activeGameType String?    @map("active_game_type")
  status         RoomStatus @default(LOBBY)

  matches Match[]
  users   RoomUser[]

  creator User @relation("CreatedRooms", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("rooms")
}

model RoomUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isReady   Boolean  @default(false) @map("is_ready")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_users")
}

model UserIDP {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUid String @unique @map("supabase_uid") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_idp")
}

model ErrorEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId      String    @map("match_id") @db.Uuid
  appearanceAt DateTime  @map("appearance_at")
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by") @db.Uuid
  positionX    Float     @map("position_x") // 画面上の位置
  positionY    Float     @map("position_y") // 画面上の位置
  user         User?     @relation(fields: [closedBy], references: [id])
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([matchId, closedAt])
  @@map("error_events")
}

model Match {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String      @map("room_id") @db.Uuid
  gameType  GameType    @map("game_type")
  status    MatchStatus @default(WAITING)
  winnerId  String?     @map("winner_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")

  errorEvents      ErrorEvent[]
  jankenEvents     JankenEvent[]
  jankenLogs       JankenLog[]
  matchScores      MatchScore[]
  nullHandMatch    NullHandMatch?
  typingShootMatch TypingShootMatch?
  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winner           User?             @relation(fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@map("matches")
}

// NULL HAND ゲーム用モデル

// Null Hand 専用のマッチメタデータ（Match の extension table）
model NullHandMatch {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId          String @unique @map("match_id") @db.Uuid
  currentTurnIndex Int    @default(1) @map("current_turn_index")
  totalTurns       Int    @default(1) @map("total_turns")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("null_hand_matches")
}

// 1ターンの状態管理
model JankenEvent {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId         String  @map("match_id") @db.Uuid
  currentHostId   String  @map("current_host_id") @db.Uuid
  turnNumber      Int     @default(1) @map("turn_number")
  phase           String  @default("DEAL")
  systemRealHand  String? @map("system_real_hand") // システムが生成した勝ち手
  systemBluffHand String? @map("system_bluff_hand") // システムが生成した負け手
  hostChoice      String? @map("host_choice") // "STAY" | "REVERSE"
  finalHostHand   String? @map("final_host_hand") // 実際に提出された手（計算結果）

  match      Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  guestHands GuestHand[]
  jankenLogs JankenLog[]

  @@map("janken_events")
}

// ゲスト各人の手を記録
model GuestHand {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jankenEventId String  @map("janken_event_id") @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  hand          String
  isConfirmed   Boolean @default(false) @map("is_confirmed")

  jankenEvent JankenEvent @relation(fields: [jankenEventId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jankenEventId, userId])
  @@map("guest_hands")
}

// 統計データ蓄積（ホストのSTAY/REVERSE選択ログ）
model JankenLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  isHost        Boolean  @default(false) @map("is_host")
  hostChoice    String?  @map("host_choice") // "STAY" | "REVERSE" (ホスト時のみ)
  matchId       String?  @map("match_id") @db.Uuid
  jankenEventId String?  @map("janken_event_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  isWinning     Boolean  @default(false) @map("is_winning")

  match       Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  jankenEvent JankenEvent? @relation(fields: [jankenEventId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isHost])
  @@map("janken_logs")
}

// ポイント管理（ターン制ゲーム用）
model MatchScore {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int      @default(0)
  turnOrder Int      @default(0) @map("turn_order")
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("match_scores")
}

// -------------------------------------------------------------------------------------------------
// 世界ランキング・永続ポイント管理
// -------------------------------------------------------------------------------------------------

// 月ごとのプレイヤーのランクと累計スコア
model MonthlyRanking {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  year        Int // 2026 など
  month       Int // 1〜12
  totalPoints Int      @default(0) @map("total_points")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month]) // 「誰が」「いつ」のレコードかを一意にする
  @@index([year, month, totalPoints(sort: Desc)]) // 月ごとのランキングを高速化
  @@map("monthly_rankings")
}

// ポイント増減の履歴（不正調査や他ゲームとの共通仕様）
model PointLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int // 獲得（または消費）した量
  gameType  String   @map("game_type") // "NULL_HAND", "ERROR_HUNTER" など
  reason    String? // "MATCH_WIN", "GAMBLE_LOSS" など
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameType])
  @@map("point_logs")
}

// -------------------------------------------------------------------------------------------------
// STAR SHIELD ゲーム用モデル
// -------------------------------------------------------------------------------------------------

model TypingShootMatch {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId             String    @unique @map("match_id") @db.Uuid
  shooterId           String    @map("shooter_id") @db.Uuid
  typistId            String    @map("typist_id") @db.Uuid
  characterName       String    @map("character_name")
  difficulty          String    @default("NORMAL")
  targetAsteroidCount Int       @default(0) @map("target_asteroid_count")
  spawnedCount        Int       @default(0) @map("spawned_count")
  destroyedCount      Int       @default(0) @map("destroyed_count")
  startedAt           DateTime  @default(now()) @map("started_at")
  endedAt             DateTime? @map("ended_at")
  isCleared           Boolean   @default(false) @map("is_cleared")
  failureReason       String?   @map("failure_reason")
  accuracyRate        Float?    @map("accuracy_rate")
  durationSeconds     Int?      @map("duration_seconds")

  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  shooter User  @relation("TypingShootShooter", fields: [shooterId], references: [id])
  typist  User  @relation("TypingShootTypist", fields: [typistId], references: [id])

  @@index([shooterId, isCleared])
  @@index([typistId, isCleared])
  @@map("typing_shoot_matches")
}

// クリア記録（ランキング・HELL解放判定用）
model StarShieldClearRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shooterId      String   @map("shooter_id") @db.Uuid
  typistId       String   @map("typist_id") @db.Uuid
  destroyedCount Int      @map("destroyed_count")
  difficulty     String
  createdAt      DateTime @default(now()) @map("created_at")

  shooter User @relation("StarShieldClearShooter", fields: [shooterId], references: [id])
  typist  User @relation("StarShieldClearTypist", fields: [typistId], references: [id])

  @@index([shooterId, typistId])
  @@index([typistId, shooterId])
  @@map("star_shield_clear_records")
}

// -------------------------------------------------------------------------------------------------
// Star Shield プログレッション（typing 通貨・ショップ）
// -------------------------------------------------------------------------------------------------

// 総合typing数（通貨）+ loadout（Shooter/Typist 時に使用するスキル）+ ヒールスキル
model StarShieldUserProgress {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @unique @map("user_id") @db.Uuid
  totalTypingCount        Int      @default(0) @map("total_typing_count")
  selectedNormalAttackId  String?  @map("selected_normal_attack_id") @db.Text
  selectedSpecialAttackId String?  @map("selected_special_attack_id") @db.Text
  selectedHealLevel       Int?     @map("selected_heal_level")
  starHpLevel             Int      @default(1) @map("star_hp_level") // 1-5
  healLevel               Int?     @map("heal_level") // 1-6（null=未所持）
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("star_shield_user_progress")
}

// 通常攻撃スキル所持（技ごとに level 1-5）
model StarShieldUserNormalAttack {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  techniqueId  String   @map("technique_id") // red, blue, yellow_beam, purple, orange
  level        Int      @default(1) // 1-5
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, techniqueId])
  @@map("star_shield_user_normal_attacks")
}

// 必殺技所持（spread_small, spread_medium, spread_large のみ。all_destruction はヒール max で獲得）
model StarShieldUserSpecialAttack {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  specialAttackId String   @map("special_attack_id")
  level           Int      @default(1) // 1-10
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, specialAttackId])
  @@map("star_shield_user_special_attacks")
}

// 購入履歴
model StarShieldPurchaseHistory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  purchaseType       String   @map("purchase_type") // SKILL_UNLOCK, LEVEL_UP
  targetSkillId      String?  @map("target_skill_id")
  targetLevel        Int?     @map("target_level")
  typingCost         Int      @map("typing_cost")
  totalTypingBefore  Int?     @map("total_typing_before")
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("star_shield_purchase_history")
}
