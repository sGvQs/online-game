generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String       @unique
  comment      String?
  createdAt    DateTime     @default(now()) @map("created_at")
  
  // リレーション名をキャメルケースに統一
  errorEvents  ErrorEvent[] 
  matches      Match[]
  joinedRooms  RoomUser[]
  createdRooms Room[]       @relation("CreatedRooms")
  userIDPs     UserIDP[]
  guestHands   GuestHand[]
  jankenLogs   JankenLog[]
  matchScores  MatchScore[]

  @@map("users")
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

model Room {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdAt      DateTime   @default(now()) @map("created_at")
  createdBy      String     @map("created_by") @db.Uuid
  currentMatchId String?    @map("current_match_id") @db.Uuid
  activeGameType String?    @map("active_game_type")
  status         RoomStatus @default(LOBBY)
  
  matches        Match[]
  users          RoomUser[]
  
  creator        User       @relation("CreatedRooms", fields: [createdBy], references: [id])

  @@map("rooms")
}

model RoomUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isReady   Boolean  @default(false) @map("is_ready")
  createdAt DateTime @default(now()) @map("created_at")
  
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_users")
}

model UserIDP {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUid String @unique @map("supabase_uid") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_idp")
}

model ErrorEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId      String    @map("match_id") @db.Uuid
  appearanceAt DateTime  @map("appearance_at")
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by") @db.Uuid
  positionX    Float     @map("position_x") // 画面上の位置
  positionY    Float     @map("position_y") // 画面上の位置
  roomId       String    @map("room_id") @db.Uuid
  user         User?     @relation(fields: [closedBy], references: [id])
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("error_events")
}

model Match {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId           String       @map("room_id") @db.Uuid
  gameType         String       @map("game_type")
  status           String       @default("WAITING")
  winnerId         String?      @map("winner_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  currentTurnIndex Int          @default(1) @map("current_turn_index")
  totalTurns       Int          @default(1) @map("total_turns")
  
  errorEvents  ErrorEvent[]
  jankenEvents JankenEvent[]
  jankenLogs   JankenLog[]
  matchScores  MatchScore[]
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winner       User?        @relation(fields: [winnerId], references: [id])

  @@map("matches")
}

// NULL HAND ゲーム用モデル

// 1ターンの状態管理
model JankenEvent {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId                String   @map("match_id") @db.Uuid
  currentHostId          String   @map("current_host_id") @db.Uuid
  turnNumber             Int      @default(1) @map("turn_number")
  phase                  String   @default("SETUP")
  phaseEndsAt            DateTime @map("phase_ends_at")
  initialHand            String?  @map("initial_hand")
  finalHostHand          String?  @map("final_host_hand")
  fakeTarget             String   @default("NONE") @map("fake_target")
  fakeHandValue          String?  @map("fake_hand_value")
  fakeChangeRateValue    Int?     @map("fake_change_rate_value")
  fakeFavoriteHandValue  String?  @map("fake_favorite_hand_value")
  
  match         Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  guestHands    GuestHand[]
  
  @@map("janken_events")
}

// ゲスト各人の手を記録
model GuestHand {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jankenEventId String      @map("janken_event_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  hand          String
  isConfirmed   Boolean     @default(false) @map("is_confirmed")
  
  jankenEvent   JankenEvent @relation(fields: [jankenEventId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
  
  @@unique([jankenEventId, userId])
  @@map("guest_hands")
}

// 統計データ蓄積
model JankenLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  initialHand String   @map("initial_hand")
  finalHand   String   @map("final_hand")
  matchId     String   @map("match_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  
  @@index([userId, initialHand])
  @@map("janken_logs")
}

// ポイント管理（ターン制ゲーム用）
model MatchScore {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  
  @@unique([matchId, userId])
  @@map("match_scores")
}