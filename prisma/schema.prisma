generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String       @unique
  comment      String?
  createdAt    DateTime     @default(now()) @map("created_at")
  
  // リレーション名をキャメルケースに統一
  errorEvents  ErrorEvent[] 
  matches      Match[]
  joinedRooms  RoomUser[]
  createdRooms Room[]       @relation("CreatedRooms")
  userIDPs     UserIDP[]

  @@map("users")
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

model Room {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  createdAt      DateTime   @default(now()) @map("created_at")
  createdBy      String     @map("created_by") @db.Uuid
  currentMatchId String?    @map("current_match_id") @db.Uuid
  activeGameType String?    @map("active_game_type")
  status         RoomStatus @default(LOBBY)
  
  matches        Match[]
  users          RoomUser[]
  
  creator        User       @relation("CreatedRooms", fields: [createdBy], references: [id])

  @@map("rooms")
}

model RoomUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isReady   Boolean  @default(false) @map("is_ready")
  createdAt DateTime @default(now()) @map("created_at")
  
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_users")
}

model UserIDP {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUid String @unique @map("supabase_uid") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_idp")
}

// モデル名をPascalCaseに変更し、@@mapで元のテーブル名を指定
model ErrorEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId      String    @map("match_id") @db.Uuid
  appearanceAt DateTime  @map("appearance_at")
  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by") @db.Uuid
  positionX    Float     @map("position_x") // 画面上の位置
  positionY    Float     @map("position_y") // 画面上の位置
  
  user         User?     @relation(fields: [closedBy], references: [id])
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("error_events")
}

// モデル名をPascalCaseに変更し、@@mapで元のテーブル名を指定
model Match {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String       @map("room_id") @db.Uuid
  gameType    String       @map("game_type")
  status      String       @default("WAITING")
  winnerId    String?      @map("winner_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  
  errorEvents ErrorEvent[]
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winner      User?        @relation(fields: [winnerId], references: [id])

  @@map("matches")
}